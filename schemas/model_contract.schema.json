{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/model-contract.schema.json",
  "title": "Math Modeling Model Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "run_id", "unit_system", "questions", "data_sources", "assumptions", "models", "terminology", "status"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.3", "1.4"]},
    "project_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "unit_system": {"type": "string", "minLength": 1},
    "problem_statement": {"type": "string"},
    "contest": {"type": "object", "additionalProperties": true},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}},
    "data_sources": {"type": "array", "items": {"$ref": "#/$defs/data_source"}},
    "assumptions": {"type": "array", "items": {"$ref": "#/$defs/assumption"}},
    "assumption_forks": {"type": "array", "items": {"$ref": "#/$defs/assumption_fork"}},
    "research_basis": {"$ref": "#/$defs/research_basis"},
    "scope_contract": {"$ref": "#/$defs/scope_contract"},
    "models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model"}},
    "terminology": {"type": "array", "items": {"$ref": "#/$defs/term"}},
    "status": {"type": "string", "enum": ["draft", "ready", "superseded"]}
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {"schema_version": {"const": "1.3"}}
        },
        {
          "properties": {
            "schema_version": {"const": "1.4"},
            "research_basis": {
              "allOf": [
                {"$ref": "#/$defs/research_basis"},
                {"required": ["research_scope", "discovery_candidates", "full_text_core", "excluded_items", "research_obligations", "stop_reason"]}
              ]
            }
          },
          "required": ["research_basis"]
        }
      ]
    }
  ],
  "$defs": {
    "scope_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "scopes", "events"],
      "properties": {
        "schema_version": {"type": "string", "const": "1.0"},
        "status": {"type": "string", "enum": ["draft", "ready", "superseded"]},
        "scopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scope_definition"}},
        "events": {"type": "array", "items": {"$ref": "#/$defs/event_definition"}},
        "notes": {"type": "string"}
      }
    },
    "scope_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "question_id", "title", "parameters", "paper_section_markers"],
      "properties": {
        "scope_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "title": {"type": "string", "minLength": 1},
        "parameters": {"type": "array", "items": {"$ref": "#/$defs/scope_parameter"}},
        "event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "paper_section_markers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "coordinate_frame": {"type": "string", "minLength": 1},
        "time_origin": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1}
      }
    },
    "scope_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "symbol", "meaning", "unit", "value", "source_locator"],
      "properties": {
        "parameter_id": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "value": {"oneOf": [{"type": "number"}, {"type": "string", "minLength": 1}]},
        "source_locator": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "event_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "question_id", "title", "definition", "paper_section_markers"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "title": {"type": "string", "minLength": 1},
        "definition": {"type": "string", "minLength": 1},
        "event_type": {"type": "string", "minLength": 1},
        "coordinate_frame": {"type": "string", "minLength": 1},
        "time_origin": {"type": "string", "minLength": 1},
        "paper_section_markers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "required_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_locator": {"type": "string", "minLength": 1}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "task", "conclusion_type", "inputs", "outputs"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "task": {"type": "string", "minLength": 1},
        "conclusion_type": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^q[1-9][0-9]*$"}},
        "required_answer": {"$ref": "#/$defs/required_answer"}
      }
    },
    "required_answer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer_type", "quantity", "unit", "scope", "must_satisfy", "reporting_semantics"],
      "properties": {
        "answer_type": {"type": "string", "enum": ["minimum_feasible_parameter", "maximum_allowed_parameter", "ranking", "prediction", "classification", "evaluation", "trajectory", "quantity", "feasible_plan", "comparison", "recommendation", "other"]},
        "quantity": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "must_satisfy": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reporting_semantics": {"type": "string", "minLength": 1},
        "output_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "data_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_id", "path", "read_only", "origin", "license_or_terms", "transformations", "quality_checks"],
      "properties": {
        "data_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "read_only": {"type": "boolean", "const": true},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "origin": {"type": "string", "minLength": 1},
        "license_or_terms": {"type": "string", "minLength": 1},
        "transformations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "quality_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "unit_notes": {"type": "string"},
        "quality_notes": {"type": "string"}
      }
    },
    "research_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "research_questions", "searches", "candidate_models", "decisions"],
      "properties": {
        "status": {"type": "string", "enum": ["draft", "verified", "ready"]},
        "research_questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/research_question"}},
        "searches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/search_record"}},
        "candidate_models": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate_model"}},
        "decisions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model_decision"}},
        "unresolved_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "research_scope": {"$ref": "#/$defs/research_scope"},
        "discovery_candidates": {"type": "array", "items": {"$ref": "#/$defs/research_source_item"}},
        "full_text_core": {"type": "array", "items": {"$ref": "#/$defs/research_source_item"}},
        "excluded_items": {"type": "array", "items": {"$ref": "#/$defs/research_source_item"}},
        "research_obligations": {"type": "array", "items": {"$ref": "#/$defs/research_obligation"}},
        "stop_reason": {"$ref": "#/$defs/research_stop_reason"}
      }
    },
    "research_scope": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "questions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "in_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "out_of_scope": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "time_box": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        }
      ]
    },
    "research_source_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_role", "evidence_ids"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "title": {"type": "string", "minLength": 1},
        "source_role": {"type": "string", "enum": ["review", "original_method", "application_research", "precedent_pattern", "other"]},
        "inclusion_reason": {"type": "string", "minLength": 1},
        "exclusion_reason": {"type": "string", "minLength": 1},
        "query_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string"}
      }
    },
    "research_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "category", "status", "critical", "evidence_ids"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["mechanism", "assumptions", "parameters", "baseline_model_selection", "validation", "failure_modes", "other"]},
        "status": {"type": "string", "enum": ["covered", "gap", "waived", "not_applicable"]},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason": {"type": "string", "minLength": 1},
        "critical": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    },
    "research_stop_reason": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason", "residual_risk"],
      "properties": {
        "kind": {"type": "string", "enum": ["coverage_satisfied", "marginal_information_low", "time_box", "waiver"]},
        "reason": {"type": "string", "minLength": 1},
        "residual_risk": {"type": ["string", "null"]}
      }
    },
    "research_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["research_id", "question_ids", "purpose", "chinese_keywords", "english_keywords"],
      "properties": {
        "research_id": {"type": "string", "minLength": 1},
        "question_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^q[1-9][0-9]*$"}},
        "purpose": {"type": "string", "minLength": 1},
        "chinese_keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "english_keywords": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "search_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["search_id", "research_ids", "query", "language", "source", "searched_at", "candidate_count"],
      "properties": {
        "search_id": {"type": "string", "minLength": 1},
        "research_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "query": {"type": "string", "minLength": 1},
        "language": {"type": "string", "enum": ["zh", "en", "mixed"]},
        "source": {"type": "string", "enum": ["llm_knowledge", "web_search", "google_scholar", "openalex", "crossref", "cnki", "publisher", "official_repository", "local_method_library", "other"]},
        "searched_at": {"type": "string", "minLength": 1},
        "candidate_count": {"type": "integer", "minimum": 0},
        "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string"}
      }
    },
    "candidate_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "question_id", "name", "mechanism_fit", "assumptions", "data_requirements", "strengths", "weaknesses", "evidence_ids", "rejection_conditions", "decision"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "mechanism_fit": {"type": "string", "minLength": 1},
        "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "data_requirements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "strengths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "weaknesses": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rejection_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "decision": {"type": "string", "enum": ["selected", "backup", "rejected"]},
        "model_id": {"type": "string", "minLength": 1}
      }
    },
    "model_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "selected_candidate_id", "alternatives_considered", "selection_criteria", "rationale", "decisive_evidence_ids", "unresolved_risks"],
      "properties": {
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "selected_candidate_id": {"type": "string", "minLength": 1},
        "alternatives_considered": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "selection_criteria": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rationale": {"type": "string", "minLength": 1},
        "decisive_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unresolved_risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "risk_disposition": {"type": "string", "minLength": 1},
        "single_candidate_waiver": {"type": "string", "minLength": 1}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumption_id", "text", "basis", "sensitivity_plan"],
      "properties": {
        "assumption_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "basis": {"type": "string", "minLength": 1},
        "sensitivity_plan": {"type": "string", "minLength": 1}
      }
    },
    "assumption_fork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fork_id", "phrase", "question_id", "interpretations", "checks"],
      "properties": {
        "fork_id": {"type": "string", "minLength": 1},
        "phrase": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "interpretations": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/fork_interpretation"}},
        "checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "selected": {"type": "string", "minLength": 1},
        "selection_reason": {"type": "string", "minLength": 1},
        "unresolved_risk": {"type": "string", "minLength": 1}
      }
    },
    "fork_interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "meaning", "mathematical_effect"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "mathematical_effect": {"type": "string", "minLength": 1}
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "meaning", "unit", "domain", "role"],
      "properties": {
        "symbol": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "domain": {"type": "string", "minLength": 1},
        "role": {"type": "string", "enum": ["decision", "parameter", "state", "index", "intermediate", "output"]}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "expression", "meaning"],
      "properties": {
        "constraint_id": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "stage", "method", "acceptance"],
      "properties": {
        "check_id": {"type": "string", "minLength": 1},
        "stage": {"type": "string", "enum": ["smoke", "full", "both"]},
        "method": {"type": "string", "minLength": 1},
        "acceptance": {"type": "string", "minLength": 1}
      }
    },
    "validation_obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["obligation_id", "category", "method", "acceptance", "required_stage"],
      "properties": {
        "obligation_id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "enum": ["data_quality", "feasibility", "objective_recomputation", "baseline", "out_of_sample", "leakage", "uncertainty", "sensitivity", "stability", "convergence", "numerical_error", "conservation", "nonanticipativity", "correlation_validity", "scenario_generalization", "other"]},
        "method": {"type": "string", "minLength": 1},
        "acceptance": {"$ref": "#/$defs/validation_acceptance"},
        "required_stage": {"type": "string", "enum": ["smoke", "full", "both"]},
        "artifact_role": {"type": "string", "enum": ["sensitivity_experiment", "oos_artifact", "failure_evidence"]},
        "claim_test": {"$ref": "#/$defs/claim_test"}
      }
    },
    "claim_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "case_role", "optimization_variable", "scope", "boundary_case", "input_case"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "case_role": {"type": "string", "enum": ["supporting", "counterexample"]},
        "optimization_variable": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1},
        "boundary_case": {"type": "string", "minLength": 1},
        "input_case": {"type": "object", "minProperties": 1}
      }
    },
    "validation_acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left_metric_id", "operator", "right", "unit"],
      "properties": {
        "left_metric_id": {"type": "string", "minLength": 1},
        "operator": {"type": "string", "enum": ["<=", "<", ">=", ">", "==", "!="]},
        "right": {"$ref": "#/$defs/validation_right_operand"},
        "unit": {"type": "string", "minLength": 1},
        "tolerance": {"type": "number", "minimum": 0}
      }
    },
    "validation_right_operand": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"type": "string", "const": "literal"},
            "value": {"type": "number"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "metric_id"],
          "properties": {
            "kind": {"type": "string", "const": "metric"},
            "metric_id": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "question_id", "name", "problem_type", "rationale", "variables", "objective", "constraints", "algorithm", "inputs", "outputs", "validation", "validation_obligations", "risks", "fallback"],
      "properties": {
        "model_id": {"type": "string", "minLength": 1},
        "question_id": {"type": "string", "pattern": "^q[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "problem_type": {"type": "string", "enum": ["optimization", "prediction", "classification", "time_series", "evaluation", "simulation", "differential_equation", "statistical_inference", "graph_network", "other"]},
        "problem_family": {"type": "string", "enum": ["optimization", "prediction", "evaluation", "classification_clustering", "mechanistic_dynamic", "other"]},
        "characteristics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["deterministic", "stochastic", "scenario_based", "correlated_inputs", "multi_stage", "time_dependent", "spatial", "multiobjective", "causal", "machine_learning"]}},
        "rationale": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/variable"}},
        "objective": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"$ref": "#/$defs/constraint"}},
        "algorithm": {"type": "string", "minLength": 1},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "validation": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation"}},
        "validation_obligations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation_obligation"}},
        "risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "fallback": {"type": "string", "minLength": 1},
        "rejected_alternatives": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "identity": {"$ref": "#/$defs/model_identity"},
        "objective_contract": {"$ref": "#/$defs/objective_contract"},
        "risk_semantics": {"$ref": "#/$defs/risk_semantics"},
        "correlation_spec": {"$ref": "#/$defs/correlation_spec"},
        "decision_context": {"$ref": "#/$defs/decision_context"},
        "statistical_design": {"$ref": "#/$defs/statistical_design"},
        "scope_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "event_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "plan_details": {"$ref": "#/$defs/model_plan_details"}
      }
    },
    "model_plan_details": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_candidate_id", "mechanism", "equation_plan", "parameter_plan", "implementation_steps", "output_artifacts", "validation_strategy", "failure_modes"],
      "properties": {
        "scaffold_entry": {"type": "string", "description": "Optional entry point in scripts/scaffold/ (e.g. scripts/scaffold/opt_milp.py) that the selected candidate binds to, so coding starts from the audited scaffold instead of a blank file."},
        "selected_candidate_id": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "equation_plan": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/equation_plan"}},
        "parameter_plan": {"type": "array", "items": {"$ref": "#/$defs/parameter_plan"}},
        "implementation_steps": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
        "output_artifacts": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "validation_strategy": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "failure_modes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "derivation_graph": {"$ref": "#/$defs/derivation_graph"}
      }
    },
    "equation_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equation_id", "purpose", "expression_or_derivation", "variables", "assumptions"],
      "properties": {
        "equation_id": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "expression_or_derivation": {"type": "string", "minLength": 1},
        "variables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "equation_type": {"type": "string", "enum": ["definition", "derivation", "constraint", "objective", "approximation", "reformulation", "theorem_application", "state_update", "other"]},
        "math_risk": {"type": "string", "enum": ["low", "medium", "high"]},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "symbols": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "domains": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "preconditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "transformation_rule": {"type": "string", "minLength": 1},
        "unit_signature": {"type": "string", "minLength": 1},
        "unit_balance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right"],
          "properties": {
            "left": {"type": "string", "minLength": 1},
            "right": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        "output_unit": {"type": "string", "minLength": 1},
        "verification": {"$ref": "#/$defs/equation_verification"}
      }
    },
    "parameter_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter", "provenance", "unit", "uncertainty_or_range"],
      "properties": {
        "parameter": {"type": "string", "minLength": 1},
        "parameter_id": {"type": "string", "minLength": 1},
        "provenance": {"$ref": "#/$defs/parameter_provenance"},
        "semantic_role": {"type": "string", "minLength": 1},
        "impact_class": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
        "sensitivity_experiment_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "unit": {"type": "string", "minLength": 1},
        "uncertainty_or_range": {"type": "string", "minLength": 1}
      }
    },
    "derivation_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/derivation_node"}},
        "edges": {"type": "array", "items": {"$ref": "#/$defs/derivation_edge"}},
        "source_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "terminal_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "derivation_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "inputs", "outputs"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "equation_id": {"type": "string", "minLength": 1},
        "type": {"type": "string", "enum": ["definition", "scenario_transform", "objective_component", "objective", "constraint", "state_update", "parameter_transform", "approximation", "reformulation", "theorem_application", "other"]},
        "inputs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "derivation_edge": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "equation_verification": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "symbol_check": {"$ref": "#/$defs/verification_status"},
        "domain_check": {"$ref": "#/$defs/verification_status"},
        "index_check": {"$ref": "#/$defs/verification_status"},
        "unit_check": {"$ref": "#/$defs/verification_status"},
        "boundary_check": {"$ref": "#/$defs/verification_status"},
        "precondition_check": {"$ref": "#/$defs/verification_status"},
        "symbolic_check": {"$ref": "#/$defs/verification_status"},
        "property_test_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "semantic_test_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "tiny_oracle_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "numeric_replay": {"type": "array", "items": {"$ref": "#/$defs/numeric_replay_case"}}
      }
    },
    "numeric_replay_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "expression", "substitutions", "expected", "unit", "abs_tolerance", "rel_tolerance", "source_locator"],
      "properties": {
        "case_id": {"type": "string", "minLength": 1},
        "expression": {"type": "string", "minLength": 1},
        "substitutions": {"type": "object", "additionalProperties": {"type": "number"}},
        "expected": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "abs_tolerance": {"type": "number", "minimum": 0},
        "rel_tolerance": {"type": "number", "minimum": 0},
        "source_locator": {"type": "string", "minLength": 1},
        "paper_section_markers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "paper_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "forbidden_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "notes": {"type": "string"}
      }
    },
    "verification_status": {
      "type": "string",
      "enum": ["PASS", "FAIL", "UNVERIFIED", "NOT_APPLICABLE"]
    },
    "parameter_provenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "source_locator"],
          "properties": {
            "type": {"type": "string", "const": "GIVEN"},
            "source_locator": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "derivation_chain", "source_variables"],
          "properties": {
            "type": {"type": "string", "const": "DERIVED"},
            "derivation_chain": {"type": "string", "minLength": 1},
            "source_variables": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "estimator", "sample_scope", "uncertainty"],
          "properties": {
            "type": {"type": "string", "const": "ESTIMATED"},
            "estimator": {"type": "string", "minLength": 1},
            "sample_scope": {"type": "string", "minLength": 1},
            "uncertainty": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "calibration_data", "calibration_objective", "independent_validation"],
          "properties": {
            "type": {"type": "string", "const": "CALIBRATED"},
            "calibration_data": {"type": "string", "minLength": 1},
            "calibration_objective": {"type": "string", "minLength": 1},
            "independent_validation": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "reason", "range", "sensitivity"],
          "properties": {
            "type": {"type": "string", "const": "ASSUMED"},
            "reason": {"type": "string", "minLength": 1},
            "range": {"type": "string", "minLength": 1},
            "sensitivity": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "official_source", "rule_snapshot"],
          "properties": {
            "type": {"type": "string", "const": "POLICY"},
            "official_source": {"type": "string", "minLength": 1},
            "rule_snapshot": {"type": "string", "minLength": 1},
            "notes": {"type": "string"}
          }
        }
      ]
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_name", "mathematical_class", "objective_form", "forbidden_aliases"],
      "properties": {
        "canonical_name": {"type": "string", "minLength": 1},
        "mathematical_class": {"type": "string", "minLength": 1},
        "objective_form": {"type": "string", "minLength": 1},
        "forbidden_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "defining_equations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "composition_type": {"type": "string", "enum": ["single_objective", "lexicographic", "weighted_sum", "epsilon_constraint", "pareto_front", "ensemble", "comparison_only", "other"]}
      }
    },
    "objective_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_id", "direction", "declared_form", "implemented_form", "equivalence_status", "recompute_test_ids", "uniqueness_claim"],
      "properties": {
        "objective_id": {"type": "string", "minLength": 1},
        "direction": {"type": "string", "enum": ["minimize", "maximize", "feasibility_only"]},
        "declared_form": {"type": "string", "minLength": 1},
        "implemented_form": {"type": "string", "minLength": 1},
        "equivalence_status": {"type": "string", "enum": ["verified", "failed", "unverified"]},
        "recompute_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "uniqueness_claim": {"type": "string", "enum": ["unique", "non_unique", "not_claimed", "unknown"]},
        "objective_diagnostics": {"$ref": "#/$defs/objective_diagnostics"},
        "piecewise_partitions": {"type": "array", "items": {"$ref": "#/$defs/piecewise_partition"}},
        "piecewise_coverage": {"$ref": "#/$defs/piecewise_coverage"},
        "notes": {"type": "string"}
      }
    },
    "objective_diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "tolerance", "candidate_count", "objective_spread", "status"],
      "properties": {
        "method": {"type": "string", "minLength": 1},
        "tolerance": {"type": "number", "minimum": 0},
        "candidate_count": {"type": "integer", "minimum": 0},
        "objective_spread": {"type": "number", "minimum": 0},
        "status": {"type": "string", "enum": ["verified", "not_run", "failed"]},
        "artifact": {"type": "string", "minLength": 1}
      }
    },
    "piecewise_partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partition_id", "condition", "boundary_status", "status"],
      "properties": {
        "partition_id": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "boundary_status": {"type": "string", "enum": ["verified", "not_applicable", "failed", "not_run"]},
        "status": {"type": "string", "enum": ["verified", "failed", "not_run"]},
        "notes": {"type": "string"}
      }
    },
    "piecewise_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "partition_ids", "coverage_status", "overlap_status"],
      "properties": {
        "domain": {"type": "string", "minLength": 1},
        "partition_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "coverage_status": {"type": "string", "enum": ["verified", "failed", "not_run"]},
        "overlap_status": {"type": "string", "enum": ["verified", "failed", "not_run"]},
        "proof_locator": {"type": "string", "minLength": 1}
      }
    },
    "risk_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["random_variable", "tail", "confidence_level", "objective_direction"],
      "properties": {
        "random_variable": {"type": "string", "enum": ["profit", "loss"]},
        "tail": {"type": "string", "enum": ["upper", "lower"]},
        "confidence_level": {"type": "number", "minimum": 0, "maximum": 1},
        "objective_direction": {"type": "string", "enum": ["minimize", "maximize"]},
        "scenario_source": {"type": "string", "minLength": 1}
      }
    },
    "correlation_spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "sample_scope", "dimension", "min_eigenvalue", "checks"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "sample_scope": {"type": "string", "minLength": 1},
        "dimension": {"type": "integer", "minimum": 2},
        "min_eigenvalue": {"type": "number"},
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": ["in_unit_interval", "symmetric", "psd_verified"],
          "properties": {
            "in_unit_interval": {"type": "boolean"},
            "symmetric": {"type": "boolean"},
            "psd_verified": {"type": "boolean"}
          }
        }
      }
    },
    "decision_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_time_column", "feature_policy", "target_horizon"],
      "properties": {
        "decision_time_column": {"type": "string", "minLength": 1},
        "feature_policy": {"type": "string", "enum": ["known_at_decision", "strict_pre_cutoff", "not_applicable"]},
        "target_horizon": {"type": "string", "minLength": 1},
        "cutoff_rule": {"type": "string", "minLength": 1},
        "forbidden_future_features": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "statistical_design": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "methods"],
      "properties": {
        "role": {"type": "string", "enum": ["primary_inference", "exploratory", "predictive_validation", "not_applicable"]},
        "methods": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["mixed_effects", "GEE", "cluster_robust_SE", "subject_level_aggregation", "grouped_bootstrap", "GroupKFold", "StratifiedGroupKFold", "GroupShuffleSplit", "row_split", "other"]}},
        "waiver_reason": {"type": ["string", "null"]},
        "unit_of_inference": {"type": "string", "minLength": 1}
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "forbidden_variants"],
      "properties": {
        "canonical": {"type": "string", "minLength": 1},
        "forbidden_variants": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "semantic_id": {"type": "string", "minLength": 1},
        "canonical_zh": {"type": "string", "minLength": 1},
        "canonical_en": {"type": "string", "minLength": 1},
        "symbol": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "allowed_aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
