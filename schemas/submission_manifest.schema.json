{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/submission-manifest.schema.json",
  "title": "Final Submission Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "run_id", "status", "frozen_at", "competition", "deadline", "paper", "support_files", "ai_disclosure", "s1_report", "run_manifest", "package_sha256", "builder"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1.1", "1.2"]},
    "project_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "const": "final_frozen"},
    "frozen_at": {"type": "string", "minLength": 1},
    "competition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "competition", "season", "profile_sha256", "rule_snapshots"],
      "properties": {
        "profile_id": {"type": "string", "minLength": 1},
        "competition": {"type": "string", "minLength": 1},
        "season": {"type": "string", "minLength": 1},
        "profile_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "rule_snapshots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file_ref"}}
      }
    },
    "deadline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closes_at", "timezone"],
      "properties": {
        "closes_at": {"type": "string", "minLength": 1},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "paper": {"$ref": "#/$defs/paper_file"},
    "support_files": {"type": "array", "items": {"$ref": "#/$defs/submission_file"}},
    "ai_disclosure": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/submission_file"}]},
    "s1_report": {"$ref": "#/$defs/file_ref"},
    "run_manifest": {"$ref": "#/$defs/file_ref"},
    "package_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "file_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "submission_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "pages": {"type": ["integer", "null"], "minimum": 1},
        "page_count_method": {"type": ["string", "null"]}
      }
    },
    "paper_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "pages", "page_count_method", "limited_pages", "ai_report_pages"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "pages": {"type": "integer", "minimum": 1},
        "page_count_method": {"type": "string", "enum": ["pdfinfo", "pypdf", "manual_verified"]},
        "limited_pages": {"type": "integer", "minimum": 1},
        "ai_report_pages": {"type": "integer", "minimum": 0},
        "body_pages": {"type": "integer", "minimum": 1}
      }
    }
  }
}
