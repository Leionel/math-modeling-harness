{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/math-modeling-harness/command-receipt.schema.json",
  "title": "Process-Captured Command Receipt (v2; v1 read compatibility)",
  "description": "Receipt is the execution-fact owner. v2 permits omitted digests for non-critical I/O; critical I/O uses one SHA-256 owner.",
  "oneOf": [
    { "$ref": "#/$defs/v2" },
    { "$ref": "#/$defs/v1_legacy" }
  ],
  "$defs": {
    "artifact_ref_v2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_id"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "artifact_id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "digest_owner": { "const": "command_receipt" },
        "critical": { "type": "boolean" }
      }
    },
    "v2": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {"properties": {"exit_code": {"type": "integer"}}},
        {
          "required": ["metadata"],
          "properties": {
            "exit_code": {"type": "null"},
            "metadata": {
              "type": "object",
              "required": ["outcome", "failure_reason", "timeout_seconds"],
              "properties": {
                "outcome": {"const": "failed"},
                "failure_reason": {"const": "timeout"},
                "timeout_seconds": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      ],
      "required": ["schema_version", "receipt_id", "command_id", "run_id", "stage", "argv", "cwd", "exit_code", "started_at", "finished_at", "stdout_path", "stderr_path", "input_refs", "output_refs"],
      "properties": {
        "schema_version": { "const": "2.0" },
        "receipt_id": { "type": "string", "minLength": 1 },
        "command_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "enum": ["safety", "smoke", "full", "freeze", "evidence", "qa", "review", "submission"] },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "exit_code": { "type": ["integer", "null"] },
        "started_at": { "type": "string", "minLength": 1 },
        "finished_at": { "type": "string", "minLength": 1 },
        "duration_s": { "type": "number", "minimum": 0 },
        "seed": { "type": ["integer", "null"] },
        "stdout_path": { "type": "string", "minLength": 1 },
        "stderr_path": { "type": "string", "minLength": 1 },
        "stdout_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "stderr_sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "input_refs": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref_v2" } },
        "output_refs": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref_v2" } },
        "selection": { "type": "object" },
        "env_note": { "type": "string" },
        "metadata": { "type": "object" },
        "previous_receipt_hash": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$",
          "description": "SHA-256 of the previous receipt file bytes in run_index order; absent for the first receipt of an index. Raises detectability of silent history rewrites, not tamper resistance."
        },
        "supersedes_receipt_id": {
          "type": "string",
          "minLength": 1,
          "description": "Optional ID of an earlier receipt in the same run/stage that this receipt supersedes."
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "description": "Monotonically increasing lineage generation counter (1 for initial run, predecessor+1 for superseding runs)."
        },
        "execution_host_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["hostname", "platform"],
          "properties": {
            "hostname": { "type": "string", "minLength": 1 },
            "platform": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "artifact_ref_v1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "existed_before": { "type": "boolean" }
      }
    },
    "v1_legacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "command_id", "stage", "argv", "cwd", "exit_code", "started_at", "finished_at", "stdout_path", "stderr_path", "input_refs", "output_refs"],
      "properties": {
        "schema_version": { "const": "1.0" },
        "command_id": { "type": "string", "minLength": 1 },
        "run_id": { "type": "string", "minLength": 1 },
        "stage": { "type": "string", "enum": ["safety", "smoke", "full", "freeze", "evidence", "qa", "review", "submission"] },
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "cwd": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "started_at": { "type": "string", "minLength": 1 },
        "finished_at": { "type": "string", "minLength": 1 },
        "duration_s": { "type": "number" },
        "seed": { "type": ["integer", "null"] },
        "stdout_path": { "type": "string", "minLength": 1 },
        "stderr_path": { "type": "string", "minLength": 1 },
        "stdout_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "stderr_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "input_refs": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref_v1" } },
        "output_refs": { "type": "array", "items": { "$ref": "#/$defs/artifact_ref_v1" } },
        "env_note": { "type": "string" }
      }
    }
  }
}
